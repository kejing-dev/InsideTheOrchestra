  "str": {
   "zh": "开头大提琴和低音提琴用手指拨弦，迈出山魔王的脚步；后来全体拿起弓来拉。",
   "en": "Cellos and basses pluck the opening steps; later every string player picks up the bow."
  },
  "ww": {
   "zh": "大管第一个吹出主题，后来双簧管、单簧管和长笛一层层加上去。",
   "en": "The bassoon plays the theme first; oboe, clarinet and flute stack on top later."
  },
  "br": {
   "zh": "开头圆号的一个长音像山洞里的回声，后半段小号和长号带着全团冲。",
   "en": "A horn's long note opens like a cave echo; later trumpets and trombones drive the chase."
  },
  "perc": {
   "zh": "定音鼓追着拍子越敲越快，最后一遍大鼓和镲一起砸下来。",
   "en": "Timpani chase the beat faster and faster; in the last round bass drum and cymbals crash in."
  }
 }
