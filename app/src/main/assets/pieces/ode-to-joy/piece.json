  "str": {
   "zh": "大提琴和低音提琴最先唱出旋律，接着中提琴、小提琴一层层接上去。",
   "en": "Cellos and basses sing the tune first; violas, then violins take it higher."
  },
  "ww": {
   "zh": "大管在旋律下面走出另一条线，后来长笛、双簧管跟着一起唱。",
   "en": "The bassoon walks a second line under the tune; later flute and oboe sing along."
  },
  "br": {
   "zh": "圆号托着和声，最后一遍小号吹旋律、长号和大号垫在下面。",
   "en": "Horns hold the harmony; in the last round the trumpet plays the tune over trombones and tuba."
  },
  "perc": {
   "zh": "最后一遍定音鼓每两拍敲一下，结尾一阵滚奏。",
   "en": "In the last round the timpani strike every two beats, then roll at the end."
  }
 }
